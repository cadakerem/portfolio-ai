# 1. Telegram Token (Required)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Access Control (Optional)
# Enter a comma-separated list of Telegram User IDs that are allowed to use this bot.
# Leave blank to allow anyone (Public Demo Mode).
ALLOWED_USER_IDS=

# 3. AI Providers (Optional - Export only one of these for Portfolio AI insights)
GROQ_API_KEY=
